# ─────────────────────────────────────────────────────────────────────────────
# DapperDriver API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins (leave empty to allow all in dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — generated when you register the webhook endpoint in Stripe Dashboard
# Stripe Dashboard → Developers → Webhooks → Add endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Firebase (FCM Push Notifications) ────────────────────────────────────────
# Paste the entire contents of your Firebase service account JSON as a single line
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used for Stripe Connect onboarding redirect URLs
FRONTEND_URL=http://localhost:3000

# ── Business Logic ────────────────────────────────────────────────────────────
# Delivery fees and driver pay rates are now stored in the platform_settings
# table in Supabase, NOT here. Update them from your admin panel or directly
# in Supabase → Table Editor → platform_settings.
#   Key: 'default_delivery_fee'  (shopper-facing flat fee, e.g. '4.99')
#   Key: 'driver_delivery_fee'   (per-delivery driver earning, e.g. '8.00')

# Timezone for Monday payout cron (IANA timezone string)
PAYOUT_TIMEZONE=America/New_York
